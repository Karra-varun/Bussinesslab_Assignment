{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/task1",
      "destination": "/task1-knowledge-brain/static/index.html"
    },
    {
      "source": "/task1/:path*",
      "destination": "/task1-knowledge-brain/static/:path*"
    },
    {
      "source": "/task2",
      "destination": "/task2-inbox-agent/public/index.html"
    },
    {
      "source": "/task2/:path*",
      "destination": "/task2-inbox-agent/public/:path*"
    },
    {
      "source": "/task3",
      "destination": "/task3-meeting-sow/static/index.html"
    },
    {
      "source": "/task3/:path*",
      "destination": "/task3-meeting-sow/static/:path*"
    },
    {
      "source": "/portal",
      "destination": "/index.html"
    }
  ]
}
